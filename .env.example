# ──────────────────────────────────────────────────────────────────────────────
#  REQUIRED — The website/app you want to proxy through this server
#  Must include the full scheme (https://) and no trailing slash.
#  Example: https://mail.google.com  or  https://app.slack.com
# ──────────────────────────────────────────────────────────────────────────────
TARGET_DOMAIN=https://your-target-site.com


# ──────────────────────────────────────────────────────────────────────────────
#  OPTIONAL — Session cookies to send with every request to the target.
#
#  HOW TO GET THESE (Chrome / Edge):
#    1. Open the TARGET site in your browser and log in normally.
#    2. Press F12 → Application tab → Storage → Cookies → (pick your site)
#    3. Copy the important cookies (session ID, auth token, etc.)
#       Format: name=value; name2=value2; name3=value3
#
#  SHORTCUT (copy ALL cookies at once):
#    1. Press F12 → Network tab
#    2. Reload the page
#    3. Click any request to your target site
#    4. In "Request Headers", find the "cookie:" header
#    5. Copy the entire value and paste it below
#
#  NOTE: Cookies expire. If the proxy stops working, re-copy fresh cookies.
# ──────────────────────────────────────────────────────────────────────────────
SESSION_COOKIE=


# ──────────────────────────────────────────────────────────────────────────────
#  OPTIONAL — Port to listen on (default: 3000)
# ──────────────────────────────────────────────────────────────────────────────
PORT=3000


# ──────────────────────────────────────────────────────────────────────────────
#  OPTIONAL — Set to "true" if running behind HTTPS (keeps Secure cookie flag)
#  Leave empty or "false" for plain HTTP development.
# ──────────────────────────────────────────────────────────────────────────────
PROXY_HTTPS=false
